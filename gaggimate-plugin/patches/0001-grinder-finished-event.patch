diff --git a/lib/BluetoothDevices/src/BluetoothGrinder.h b/lib/BluetoothDevices/src/BluetoothGrinder.h
index f1296253..a3d4c278 100644
--- a/lib/BluetoothDevices/src/BluetoothGrinder.h
+++ b/lib/BluetoothDevices/src/BluetoothGrinder.h
@@ -21,13 +21,30 @@ class BluetoothGrinder : public BluetoothDevice {
     const GrinderSettings &getReportedSettings() const { return reportedSettings; }
     GrinderState getState() const { return state; }
 
+    // Hands out the weight (grams) of a finished grind once; false when none is pending.
+    bool takeGrindFinished(float &grams) {
+        if (!grindFinishedPending) {
+            return false;
+        }
+        grams = grindFinishedGrams;
+        grindFinishedPending = false;
+        return true;
+    }
+
   protected:
     explicit BluetoothGrinder(const DiscoveredDevice &device) : BluetoothDevice(device, TYPE) {}
 
     void setReportedSettings(const GrinderSettings &settings) { reportedSettings = settings; }
     void setState(GrinderState newState) { state = newState; }
+    // Drivers call this from update() when a grind has finished; one slot, the latest report wins.
+    void reportGrindFinished(float grams) {
+        grindFinishedGrams = grams;
+        grindFinishedPending = true;
+    }
 
   private:
     GrinderSettings reportedSettings;
     GrinderState state = GrinderState::UNKNOWN;
+    float grindFinishedGrams = 0.0f;
+    bool grindFinishedPending = false;
 };
