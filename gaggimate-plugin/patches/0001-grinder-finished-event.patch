+++ b/src/display/plugins/BluetoothDevicesPlugin.cpp
@@ -171,6 +171,7 @@ void BluetoothDevicesPlugin::update() {
         }
         device->update();
         pollDeviceMetadata(type);
+        pollGrinderEvents(type);
     }
     if (connectionLost) {
         // A stopped scanner still lists the lost device; starting it clears the list so it is not "found" right away.
@@ -361,6 +362,18 @@ void BluetoothDevicesPlugin::pollDeviceMetadata(BluetoothDeviceType type) {
     }
 }
 
+void BluetoothDevicesPlugin::pollGrinderEvents(BluetoothDeviceType type) {
+    DeviceSlot &deviceSlot = slot(type);
+    if (deviceSlot.device == nullptr || pluginManager == nullptr) {
+        return;
+    }
+    BluetoothGrinder *connectedGrinder = deviceSlot.device->asGrinder();
+    float grams = 0.0f;
+    if (connectedGrinder != nullptr && connectedGrinder->takeGrindFinished(grams)) {
+        pluginManager->trigger("grinder:grind:finished", "value", grams);
+    }
+}
+
 void BluetoothDevicesPlugin::tare() const { onProcessStart(); }
 
